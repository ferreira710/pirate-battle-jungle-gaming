{
	"name": "pirate-battle",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite --host",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"lint": "eslint .",
		"typecheck": "tsc -b",
		"test:e2e": "playwright test",
		"test:e2e:desktop": "playwright test --project=desktop-chromium",
		"test:e2e:mobile": "playwright test --project=mobile-chromium",
		"test:e2e:update": "playwright test --update-snapshots",
		"test:e2e:report": "playwright show-report",
		"perf": "playwright test -c playwright.perf.config.ts",
		"perf:headless": "PERF_HEADLESS=1 playwright test -c playwright.perf.config.ts"
	},
	"dependencies": {
		"@tanstack/react-query": "^5.108.4",
		"axios": "^1.21.1",
		"pixi.js": "^8.23.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@playwright/test": "^1.65.1",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"msw": "^3.0.7",
		"oxlint": "^1.90.0",
		"typescript": "~7.0.2",
		"vite": "^8.3.6"
	},
	"msw": {
		"workerDirectory": [
			"public"
		]
	}
}
